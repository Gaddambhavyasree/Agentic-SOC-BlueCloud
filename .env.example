# Local configuration for the scripts in this repository.
#
# Copy this file to .env and fill in the values locally:
#     Copy-Item .env.example .env
#
# .env is git-ignored. NEVER commit real credentials.
#
# Only GRAFANA_USER / GRAFANA_PASSWORD are secrets. GRAFANA_URL is internal
# addressing for this lab and is fine to keep in a private repo, but keeping it
# here (instead of hard-coding it in scripts) is what makes the tooling portable
# to a rebuilt instance.

# Base URL of the Grafana instance that holds the dashboards.
GRAFANA_URL=http://192.168.3.55:3000

# Alternative entry point if the lab is reachable over TailScale.
# GRAFANA_URL=http://100.126.218.97:3000

# Grafana user with read access to the dashboards (Viewer is enough for export
# and validation; Admin is only needed to import).
GRAFANA_USER=admin

# Grafana password or service account token. LEAVE BLANK IN THIS FILE.
# Set it in your local .env, or export it in the shell:
#     $env:GRAFANA_PASSWORD='...'
GRAFANA_PASSWORD=

# Base URL of the OpenSearch Dashboards instance that the dashboard drill-down
# links point at. Only needed if you re-point those links (see
# docs/WORKSTREAM-AUDIT.md, finding F17).
OSD_BASE_URL=https://192.168.1.210:20443
